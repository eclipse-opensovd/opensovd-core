load("//bazel:rust_crate.bzl", "workspace_rust_library")

package(default_visibility = ["//:workspace_crates"])

exports_files(["Cargo.toml"])

workspace_rust_library(
    name = "opensovd_providers",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "indexmap",
        "schemars",
        "serde",
        "serde_json",
        "thiserror",
    ],
    crate_name = "opensovd_providers",
    crate_root = "src/lib.rs",
    proc_macro_crate_deps = [
        "async-trait",
    ],
    version = "0.1.1",
    deps = [
        "//opensovd-core:opensovd_core",
        "//opensovd-models:opensovd_models",
    ],
)
