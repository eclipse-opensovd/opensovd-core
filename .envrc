# shellcheck shell=bash

if has nix; then
  # direnv only watches flake.nix and flake.lock, but the shell also comes from
  # rust-toolchain.toml and nix. A stale cache there fails silently.
  watch_file rust-toolchain.toml
  watch_dir nix
  use flake
else
  echo "nix not found. Install it from https://nixos.org/download/ (flakes enabled)."
fi
