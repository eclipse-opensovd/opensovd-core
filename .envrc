# shellcheck shell=bash

if has nix; then
  # The flake reads rust-toolchain.toml, but direnv only watches flake.{nix,lock}
  # by default. Without this, a toolchain bump doesn't trigger a reload.
  watch_file rust-toolchain.toml
  use flake
else
  echo "nix not found. Install it from https://nixos.org/download/ (flakes enabled)."
fi
