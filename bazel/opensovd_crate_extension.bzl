"""Crate-universe extension identity with access to Core's platform settings."""

load("@rules_rust//crate_universe:extensions.bzl", _crate = "crate")

# Repositories generated by an extension see the repositories visible to the
# module that defines it. Defining it here lets crate BUILD files select on
# @opensovd_core//bazel settings.
crate = _crate
