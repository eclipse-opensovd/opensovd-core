load("//bazel:rust_crate.bzl", "workspace_rust_binary")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

COMMON_DEPS = [
    "//opensovd-cli/lib:libcli",
    "//opensovd-core:opensovd_core",
    "//opensovd-extra:opensovd_extra",
    "//opensovd-mocks:opensovd_mocks",
    "//opensovd-models:opensovd_models",
    "//opensovd-providers:opensovd_providers",
    "//opensovd-server:opensovd_server",
]

workspace_rust_binary(
    name = "simple_example",
    srcs = ["simple/simple.rs"],
    crate_deps = [
        "jsonwebtoken",
        "sd-notify",
        "sysinfo",
        "tokio",
        "tracing",
    ],
    crate_features = ["tls"],
    crate_name = "simple",
    crate_root = "simple/simple.rs",
    proc_macro_crate_deps = [
        "async-trait",
    ],
    version = "0.1.1",
    deps = COMMON_DEPS,
)

workspace_rust_binary(
    name = "systemd_example",
    srcs = ["systemd/systemd.rs"],
    crate_deps = [
        "jsonwebtoken",
        "sd-notify",
        "sysinfo",
        "tokio",
        "tracing",
    ],
    crate_features = ["tls"],
    crate_name = "systemd",
    crate_root = "systemd/systemd.rs",
    proc_macro_crate_deps = [
        "async-trait",
    ],
    version = "0.1.1",
    deps = COMMON_DEPS,
)

workspace_rust_binary(
    name = "auth_example",
    srcs = ["auth/auth.rs"],
    crate_deps = [
        "jsonwebtoken",
        "sd-notify",
        "sysinfo",
        "tokio",
        "tracing",
    ],
    compile_data = [
        "auth/sovd_authz.rego",
        "auth/sovd_data.json",
    ],
    crate_features = ["tls"],
    crate_name = "auth",
    crate_root = "auth/auth.rs",
    proc_macro_crate_deps = [
        "async-trait",
    ],
    version = "0.1.1",
    deps = COMMON_DEPS,
)

workspace_rust_binary(
    name = "mtls_example",
    srcs = ["mtls/mtls.rs"],
    crate_deps = [
        "jsonwebtoken",
        "sd-notify",
        "sysinfo",
        "tokio",
        "tracing",
    ],
    crate_features = ["tls"],
    crate_name = "mtls",
    crate_root = "mtls/mtls.rs",
    proc_macro_crate_deps = [
        "async-trait",
    ],
    version = "0.1.1",
    deps = COMMON_DEPS + [
        "@crate_index//:rustls",
    ],
)

filegroup(
    name = "server_examples",
    srcs = [
        ":simple_example",
        ":systemd_example",
        ":auth_example",
        ":mtls_example",
    ],
)
