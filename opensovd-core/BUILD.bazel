load("//bazel:rust_crate.bzl", "workspace_rust_library")

package(default_visibility = ["//:workspace_crates"])

exports_files(["Cargo.toml"])

workspace_rust_library(
    name = "opensovd_core",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "bytes",
        "chrono",
        "futures-core",
        "indexmap",
        "serde_json",
        "thiserror",
        "tokio",
    ],
    crate_name = "opensovd_core",
    crate_root = "src/lib.rs",
    proc_macro_crate_deps = [
        "async-trait",
    ],
    version = "0.1.1",
)
