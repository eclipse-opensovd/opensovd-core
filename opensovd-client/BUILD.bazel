load("//bazel:rust_crate.bzl", "workspace_rust_library", "workspace_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

COMMON_TEST_SRCS = glob(["tests/common/**/*.rs"])

workspace_rust_library(
    name = "opensovd_client",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "bytes",
        "http",
        "http-body",
        "http-body-util",
        "hyper",
        "hyper-util",
        "percent-encoding",
        "serde",
        "serde_json",
        "thiserror",
        "tokio",
        "tower",
        "tower-service",
    ],
    crate_name = "opensovd_client",
    crate_root = "src/lib.rs",
    compile_data = ["README.md"],
    version = "0.1.1",
    deps = [
        "//opensovd-models:opensovd_models",
    ],
)

workspace_rust_test(
    name = "unit_test",
    crate = ":opensovd_client",
    crate_deps = [
        "mock-http-connector",
        "serde_json",
        "tempfile",
        "tokio",
        "tower",
    ],
)

