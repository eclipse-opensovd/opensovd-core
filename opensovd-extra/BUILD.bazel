load("//bazel:rust_crate.bzl", "workspace_rust_library")

package(default_visibility = ["//:workspace_crates"])

exports_files(["Cargo.toml"])

workspace_rust_library(
    name = "opensovd_extra",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "axum",
        "aws-lc-rs",
        "bytes",
        "futures",
        "http",
        "http-body",
        "http-body-util",
        "jsonwebtoken",
        "percent-encoding",
        "regorus",
        "serde",
        "serde_json",
        "rustls",
        "thiserror",
        "tokio",
        "tower",
        "tower-http",
        "tracing",
    ],
    crate_features = [
        "auth",
        "federation",
        "tls",
        "trace",
    ],
    crate_name = "opensovd_extra",
    crate_root = "src/lib.rs",
    version = "0.1.1",
    deps = [
        "//opensovd-models:opensovd_models",
        "//opensovd-server:opensovd_server",
    ],
)
