load("//bazel:rust_crate.bzl", "workspace_rust_library")

package(default_visibility = ["//:workspace_crates"])

exports_files(["Cargo.toml"])

workspace_rust_library(
    name = "libcli",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "chrono",
        "http",
        "tokio",
        "tower-http",
        "tracing",
        "tracing-subscriber",
    ],
    crate_name = "libcli",
    crate_root = "src/lib.rs",
    version = "0.1.1",
)
