load("@crate_index//:defs.bzl", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//bazel:rust_crate.bzl", "workspace_cargo_build_script", "workspace_rust_binary", "workspace_rust_library")

package(default_visibility = ["//:workspace_crates"])

exports_files(["Cargo.toml"])

workspace_cargo_build_script(
    name = "build_script_build",
    srcs = ["build.rs"],
    crate_name = "build_script_build",
    crate_root = "build.rs",
    pkg_name = "opensovd-gateway",
    version = "0.1.1",
    deps = ["//opensovd-cli/build:libcli_build"],
)

workspace_rust_library(
    name = "opensovd_gateway_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_deps = [
        "anyhow",
        "clap",
        "http",
        "http-body-util",
        "schemars",
        "sd-notify",
        "serde",
        "serde_json",
        "socket2",
        "tokio",
        "tower",
        "tower-http",
        "tracing",
    ],
    crate_features = [
        "json-preserve-order",
        "jsonschema",
        "mdns",
        "mock",
        "tls",
    ],
    crate_name = "opensovd_gateway",
    crate_root = "src/lib.rs",
    version = "0.1.1",
    visibility = ["//visibility:public"],
    deps = [
        ":build_script_build",
        "//opensovd-cli/lib:libcli",
        "//opensovd-core:opensovd_core",
        "//opensovd-extra:opensovd_extra",
        "//opensovd-mocks:opensovd_mocks",
        "//opensovd-server:opensovd_server",
        "@crate_index//:rustls",
    ],
)

workspace_rust_binary(
    name = "opensovd_gateway",
    srcs = ["src/main.rs"],
    crate_deps = [
        "clap",
        "tokio",
    ],
    crate_name = "opensovd_gateway_bin",
    crate_root = "src/main.rs",
    version = "0.1.1",
    deps = [
        ":opensovd_gateway_lib",
        "//opensovd-cli/lib:libcli",
    ],
)

rust_test(
    name = "upstream_config_test",
    crate = ":opensovd_gateway_lib",
    crate_features = [
        "json-preserve-order",
        "jsonschema",
        "mdns",
        "mock",
        "tls",
    ],
    deps = [
        "//opensovd-models:opensovd_models",
        "//opensovd-providers:opensovd_providers",
    ],
)

rust_test(
    name = "embedded_usage_test",
    srcs = ["tests/embedded.rs"],
    crate_name = "embedded_usage_test",
    edition = "2024",
    deps = [
        ":opensovd_gateway_lib",
        "//:opensovd-core",
        "//:opensovd-models",
        "//:opensovd-providers",
    ] + crate_deps(["tokio"]),
)

rust_test(
    name = "mdns_discovery_test",
    srcs = ["tests/mdns_discovery.rs"],
    crate_features = ["mdns"],
    crate_name = "mdns_discovery_test",
    edition = "2024",
    deps = [
        ":opensovd_gateway_lib",
        "//:opensovd-core",
        "//opensovd-extra:opensovd_extra",
        "//opensovd-server:opensovd_server",
    ] + crate_deps([
        "anyhow",
        "tokio",
    ]),
)
