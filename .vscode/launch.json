{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug integration test 'integration_tests'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--package",
          "sovd-server",
          "--test",
          "integration_tests",
        ],
        "filter": {
          "kind": "test",
          "name": "integration_tests"
        }
      },
      "args": [
        "--nocapture",
        "--test-threads=1"
      ],
      "cwd": "${workspaceFolder}",
      "env": {"RUST_BACKTRACE": "1"}
    },

    
    {
      "name": "Attach to Running Process",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickProcess}",
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Run and Debug Rust Server",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/sovd-server",
      "args": ["127.0.0.1", "8000", "chassis-hpc", "--sovd-mode", "standalone"],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    }

  ]

    
  
}
